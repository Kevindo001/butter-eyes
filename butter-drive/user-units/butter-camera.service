# Starts Butter's camera stream when the Jetson boots.
[Unit]
Description=Butter camera stream
After=network.target

[Service]
WorkingDirectory=%h/Projects/butter-drive
ExecStart=%h/Projects/butter/butter_env/bin/python3 camera_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
